# Copy to /etc/finova/finova.env, owned by root with mode 0600.
# Replace placeholders ON THE SERVER. Never commit the populated file.
FINOVA_DEPLOYMENT=proxy
HOST=127.0.0.1
PORT=8000
FINOVA_PUBLIC_ORIGIN=https://finova.example.com
FINOVA_PROXY_TOKEN=REPLACE_WITH_SERVER_GENERATED_TOKEN
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=paste_your_team_key_here
