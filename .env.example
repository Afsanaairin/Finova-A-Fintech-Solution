OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=api key here
# Local preview defaults to 127.0.0.1, port 8000.
HOST=127.0.0.1
PORT=8000

# Gmail SMTP credentials stay on the server. Use a Google app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=

# Login codes last 5 minutes; login sessions last 7 days.
AUTH_CODE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=604800
# Enable secure cookies when serving the website over HTTPS.
COOKIE_SECURE=false
# Set the exact external origin when using a reverse proxy, e.g. https://finova.example.com.
PUBLIC_ORIGIN=
